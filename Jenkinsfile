pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'E-commerce source code checked out'
            }
        }

        stage('Build') {
            steps {
                echo 'Building E-commerce application'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests'
            }
        }
    }
}